{
  "schemaVersion": 1,
  "id": "clickergamehud",
  "version": "${version}",
  "name": "+1 clicker Game HUD",
  "description": "Adds essential +1 Clicker features!",
  "authors": ["FrostFizzie"],
  "contact": {
    "sources": "https://github.com/FrostFizzie/ClickerGameHud",
    "issues": "https://github.com/FrostFizzie/ClickerGameHud/issues",
    "homepage": "https://modrinth.com/mod/%2B1-clicker-essentials"
  },
  "license": "MIT",
  "icon": "assets/clickergamehud/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.frostfizzie.clickergamehud.client._1ClickerGameHUDClient"
    ],
    "main": [
      "com.frostfizzie.clickergamehud._1ClickerGameHUD"
    ],
    "modmenu": ["com.frostfizzie.clickergamehud.config.ModMenuImpl"]
  },
  "mixins": [
    "clickergamehud.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "26.3",
    "modmenu": "21.0.0",
    "yet_another_config_lib_v3": "3.9.7"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/client/gui/components/PlayerTabOverlay": ["com/frostfizzie/clickergamehud/Accessors/PlayerListMethods"]
    }
  }
}
